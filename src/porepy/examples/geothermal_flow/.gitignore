*.vtk
!model_configuration/constitutive_description/driesner_vtk_files/*.vtk

# In the subsection_4_* folders, track ONLY Python and Markdown sources: everything else
# (simulation output, VTU/VTR/PVD, logs, figures, caches) is generated by the scripts.
# (Un-ignoring the directories themselves is required so git descends to find the sources.)
subsection_4_1/**
!subsection_4_1/**/
!subsection_4_1/**/*.py
!subsection_4_1/**/*.md

subsection_4_2/**
!subsection_4_2/**/
!subsection_4_2/**/*.py
!subsection_4_2/**/*.md

subsection_4_3/**
!subsection_4_3/**/
!subsection_4_3/**/*.py
!subsection_4_3/**/*.md
