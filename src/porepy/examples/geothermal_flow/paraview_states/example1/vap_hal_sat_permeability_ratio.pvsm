      <Property name="Script" id="117250.Script" number_of_elements="1">
        <Element index="0" value="import numpy as np&#xa;&#xa;# 1. Use the CamelCase VTK method on the underlying VTKObject&#xa;# inputs[0] is the wrapped object, inputs[0].VTKObject is the raw VTK class&#xa;output.ShallowCopy(inputs[0].VTKObject)&#xa;&#xa;# List of variables to fix&#xa;vars_to_fix = [&#x27;z_NaCl&#x27;, &#x27;s_halite&#x27;, &#x27;s_gas&#x27;]&#xa;&#xa;for var in vars_to_fix:&#xa;    # Check if the array exists in the input&#xa;    if var in inputs[0].CellData.keys():&#xa;        arr = inputs[0].CellData[var]&#xa;        &#xa;        # 2. Use np.maximum to clip values below 0&#xa;        # This appends/overwrites the array in the output object&#xa;        output.CellData.append(np.maximum(arr, 0), var)"/>
      </Property>
      <Property name="TimestepValues" id="117250.TimestepValues" number_of_elements="8">
        <Element index="0" value="0"/>
        <Element index="1" value="360"/>
        <Element index="2" value="720"/>
        <Element index="3" value="1080"/>
        <Element index="4" value="1440"/>
        <Element index="5" value="1800"/>
        <Element index="6" value="2160"/>
        <Element index="7" value="2520"/>
      </Property>
      <Property name="UpdateExtentScript" id="117250.UpdateExtentScript" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
    </Proxy>
